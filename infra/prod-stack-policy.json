{
    "Statement": [
        {
            "Sid": "NeverReplaceOrDeleteTheSiteOrItsBucket",
            "Effect": "Deny",
            "Principal": "*",
            "Action": ["Update:Replace", "Update:Delete"],
            "Resource": [
                "LogicalResourceId/WebsiteBucket",
                "LogicalResourceId/CloudFrontDistribution"
            ]
        },
        {
            "Effect": "Allow",
            "Principal": "*",
            "Action": "Update:*",
            "Resource": "*"
        }
    ]
}
